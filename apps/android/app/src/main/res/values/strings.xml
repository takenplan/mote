<resources>
    <string name="app_name">Mote Context Collector</string>
    <string name="accessibility_name">Mote Screen Capture</string>
    <string name="accessibility_description">Collects only after you tap Start. Reads app identity for your privacy rules and captures screenshots. When you explicitly enable page collection and configure rules, also reads visible UI text, filtering passwords, input fields and masked regions. Never taps, scrolls or executes page instructions. Records are queued privately and uploaded to your configured central node. Stop anytime in the app or notification.</string>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">@color/mote_accent</item>
        <item name="android:textColor">@color/mote_ink</item>
        <item name="android:textColorPrimary">@color/mote_ink</item><item name="android:textColorSecondary">@color/mote_muted</item>
        <item name="android:windowBackground">@color/mote_background</item><item name="android:statusBarColor">@color/mote_background</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:navigationBarColor">@color/mote_background</item>
        <item name="android:windowLightNavigationBar">false</item><item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item><item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
