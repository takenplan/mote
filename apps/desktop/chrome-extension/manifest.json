{
  "manifest_version": 3,
  "name": "Mote visible context",
  "version": "1.0.0",
  "key": "",
  "description": "Reads visible page evidence only when your local Mote collector requests it.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "activeTab",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
