// Opt-in generated-data acceptance. Uses the compiled runtime and existing local
// images. Only this run's labelled volumes/containers are stopped or removed.
import test from 'node:test';
import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
import {createHash,randomUUID} from 'node:crypto';
import {mkdtempSync,mkdirSync,readFileSync,writeFileSync,rmSync,realpathSync,existsSync} from 'node:fs';
import {join,relative} from 'node:path';
import {tmpdir} from 'node:os';
import {DatabaseSync} from 'node:sqlite';
import {setTimeout as delay} from 'node:timers/promises';

import {pathToFileURL} from 'node:url';
import {assertFinalFreeze,syntheticOwner,splitOriginal,sha256,representation,snapshotOwnedRows,assertSameData,retainedTables} from './final-recovery-support.ts';
import {prepareGenerationHistory,assertGenerationHistory} from './generation-history-settled.ts';
import {rejectCorruptSyntheticArchives} from './archive-corruptions.mjs';
import {OwnedDockerResources} from './owned-cleanup.mjs';
import {syntheticImageIO} from './synthetic-image-io.ts';
import {artifactTree} from './artifact-tree.mjs';
import {prepareAttachmentHistory,assertAttachmentHistory} from './attachment-history.ts';
import {prepareStorageHistory,assertStorageFiles,assertPersonalPlaintext,commitRestoredPending,assertStorageReads,recordPersonalImportFormat,recordPendingCommit} from './storage-history.ts';

const workspace=realpathSync(process.env.MOTE_FINAL_RECOVERY_WORKSPACE!);
const candidate=process.env.MOTE_FINAL_RECOVERY_CANDIDATE!;
const sourceProof=assertFinalFreeze(workspace,candidate,process.env.MOTE_FINAL_RECOVERY_MANIFEST!,process.env.MOTE_FINAL_RECOVERY_MANIFEST_SHA256!);
const matrixImplementationComplete=true;
assert.ok(matrixImplementationComplete,'Preparation scaffold: finish final-C matrix wiring before any runtime import');
const evidenceRoot=realpathSync(process.env.MOTE_FINAL_RECOVERY_EVIDENCE_DIRECTORY!);
assert.ok(evidenceRoot.includes('mote-final-recovery7-'));
const buildProof=JSON.parse(readFileSync(process.env.MOTE_FINAL_RECOVERY_BUILD_RECEIPT!,'utf8'));
assert.equal(buildProof.candidate,candidate);assert.equal(buildProof.lockHash,sha256(readFileSync(join(workspace,'package-lock.json'))));
assert.equal(artifactTree(workspace,buildProof.inputPaths).sha256,buildProof.artifactSha256,'Fresh host build changed');
const httpProof=process.env.MOTE_FINAL_RECOVERY_HTTP_RECEIPT?JSON.parse(readFileSync(process.env.MOTE_FINAL_RECOVERY_HTTP_RECEIPT,'utf8')):undefined;
if(httpProof){assert.equal(httpProof.candidate,candidate);assert.ok(realpathSync(httpProof.log).startsWith(evidenceRoot+'/'));assert.equal(sha256(readFileSync(httpProof.log)),httpProof.logSha256);assert.equal(sha256(readFileSync(new URL('./compiled-http-host.mjs',import.meta.url))),httpProof.hostSha256);}
const {buildApp}=await import(pathToFileURL(join(workspace,"apps/server/dist/app.js")).href);
const {defaultModelSettings}=await import(pathToFileURL(join(workspace,"apps/server/dist/model-settings.js")).href);
const {EXECUTION_POLICIES}=await import(pathToFileURL(join(workspace,"apps/server/dist/execution-policy.js")).href);
const {ManagedHindsightRuntime,hindsightModelFingerprint,hindsightDigest}=await import(pathToFileURL(join(workspace,"apps/server/dist/hindsight-runtime.js")).href);
const {HindsightEngine}=await import(pathToFileURL(join(workspace,"apps/server/dist/hindsight-engine.js")).href);
const {memoryBodyDigest,memoryProviderRecordSchema}=await import(pathToFileURL(join(workspace,"apps/server/dist/memory-provider-contract.js")).href);
const {generatedHindsightRelease}=await import(pathToFileURL(join(workspace,"apps/server/test/fixtures/scoped-memory-release.ts")).href);
const {backupScopedInstance,restoreScopedInstance}=await import(pathToFileURL(join(workspace,"scripts/scoped-backup.mjs")).href);
const {initialize,profilePaths,loadProfile,restoreProfile,backupProfile,dockerConfigurationUser}=await import(pathToFileURL(join(workspace,"scripts/profile-lib.mjs")).href);
const {HINDSIGHT_BACKUP_IMAGE}=await import(pathToFileURL(join(workspace,"scripts/hindsight-backup.mjs")).href);
const {writeMessagesResponse}=await import(pathToFileURL(join(workspace,'scripts/fixtures/messages-provider.ts')).href);
const image=process.env.MOTE_CONTAINER_VALIDATION_IMAGE;
assert.ok(image,'Final-C recovery requires an explicit newly built validation image');
const digest=(value:unknown)=>createHash('sha256').update(typeof value==='string'?value:JSON.stringify(value)).digest('hex');
const password='Generated-policy-native-recovery-only',protocol={'x-mote-protocol-version':'2','x-mote-ingress-version':'3'};
const policy={version:1,services:[{id:'ocr',name:'Generated OCR',kind:'image',reference:{kind:'personal',id:'generated-ocr'}},{id:'language',name:'Generated language',kind:'model',reference:{kind:'personal',id:'generated-language'}}],profiles:[{id:'text',name:'Generated text',processorId:'text.utf8',parameters:{},diarizationProcessor:'audio.diarize',summarize:false},{id:'image',name:'Generated built-in image graph',processorId:'image.http',serviceId:'ocr',modelServiceId:'language',parameters:{},summarize:false,imageRecipe:{id:'generated.recovery-image',version:'1'}},{id:'archive',name:'Generated original',processorId:'archive',parameters:{},diarizationProcessor:'audio.diarize',summarize:false}],rules:[{type:'text/*',profileId:'text'},{type:'image/*',profileId:'image'},{type:'*/*',profileId:'archive'}]};
function sql<T>(directory:string,work:(db:DatabaseSync)=>T){const db=new DatabaseSync(join(directory,'mote.sqlite'));try{db.exec('PRAGMA busy_timeout=5000; PRAGMA foreign_keys=ON');return work(db);}finally{db.close();}}
function plans(directory:string){return sql(directory,db=>Object.fromEntries(['mp_file_plans','mp_file_policy_bindings','mp_file_controls'].map(table=>[table,db.prepare('SELECT * FROM '+table+' ORDER BY user_id,'+(table==='mp_file_plans'?'id':'original_id')).all()])));}

test('final-C2 compiled complete personal/native/Hindsight/Docker recovery preserves data without reviving authority',{skip:!image,timeout:600000},async t=>{
 const runId='mote-final-recovery7-'+randomUUID(),root=realpathSync(mkdtempSync(join(tmpdir(),runId+'-'))),source=join(root,'source');
 const rawDocker=(args:string[])=>{try{return {status:0,stdout:execFileSync('docker',args,{encoding:'utf8',timeout:240000,maxBuffer:64*1024*1024,stdio:['ignore','pipe','pipe']}),stderr:''};}catch(error:any){return {status:error.status??1,stdout:String(error.stdout??''),stderr:String(error.stderr??'')};}};
 const exactAbsent=(kind:string,name:string,result:any)=>result.status!==0&&[`Error response from daemon: No such ${kind}: ${name}`,`Error: No such ${kind}: ${name}`,...(kind==='container'?[`Error: No such object: ${name}`]:[`Error response from daemon: get ${name}: no such volume`])].includes(result.stderr.trim());
 const createdVolumeLabels=new Map<string,Record<string,string>>();
 const docker=(input:string[])=>{let args=[...input];if(args[0]==='run'){if(!args.includes('--name'))args=['run','--name',runId+'-helper-'+(++helper),'--label','dev.mote.fixture='+runId,...args.slice(1)];const name=args[args.indexOf('--name')+1],probe=rawDocker(['inspect','--type','container',name]);assert.ok(exactAbsent('container',name,probe),'Refusing an occupied/unknown container name: '+name);central.add(name);}if(args[0]==='volume'&&args[1]==='create'){const name=args.at(-1)!,probe=rawDocker(['volume','inspect',name]);assert.ok(exactAbsent('volume',name,probe),'Refusing an occupied/unknown volume name: '+name);const labels:Record<string,string>={};for(let i=0;i<args.length-1;i++)if(args[i]==='--label'){const value=args[++i],at=value.indexOf('=');assert.ok(at>0);labels[value.slice(0,at)]=value.slice(at+1);}assert.ok(labels['dev.mote.fixture']===runId||labels['dev.mote.profile']||labels['mote.runtime.identity'],'New volume lacks ownership provenance');createdVolumeLabels.set(name,labels);if(labels['mote.runtime.identity'])nativeIds.add(labels['mote.runtime.identity']);}const result=rawDocker(args);assert.equal(result.status,0,'Owned Docker command failed: '+args[0]+' '+result.stderr);return result.stdout.trim();};
 const completedMatrix=new Set<string>();
 const central=new Set<string>(),volumes=new Map<string,string>(),nativeIds=new Set<string>(),managed:any[]=[];
 let app:any,io:any,helper=0,modelCalls=0,passed=false,completionResult:any,nativeArchivePaths:string[]=[];
 const progress=(phase:string)=>writeFileSync(join(evidenceRoot,'progress.json'),JSON.stringify({runId,phase,at:new Date().toISOString(),passed,central:[...central],nativeIds:[...nativeIds],volumes:[...volumes.keys()]}));
 const execute=async(command:string,args:string[])=>{assert.equal(command,'docker');return docker(args[0]==='run'?['run','--name',runId+'-helper-'+(++helper),'--label','dev.mote.fixture='+runId,...args.slice(1)]:args);};
 t.after(async()=>{
  const errors:any[]=[];const attempt=async(action:string,work:()=>unknown)=>{try{await work();}catch(error){errors.push({action,error:String(error)});}};
  await attempt('close generated external IO',()=>io?.close());await attempt('close compiled app',()=>app?.app.close());for(const [index,runtime] of managed.entries())await attempt('close owned native runtime '+index,()=>runtime.close());
  const ledger=new OwnedDockerResources(runId,async(args:string[])=>rawDocker(args));
  // Discover restored native descriptors only inside our labelled profile
  // volumes, before removing a copied profile that may be their sole ledger.
  for(const [volume,owner] of [...volumes])await attempt('discover native descriptors '+volume,async()=>{const state=await ledger.inspect('volume',volume);if(!state||state.Labels?.['dev.mote.profile']!==owner||!nativeArchivePaths.length)return;const found=JSON.parse(docker(['run','--rm','--pull','never','--network','none','--read-only','--user','0','--mount','type=volume,source='+volume+',target=/data,readonly','--entrypoint','node',image!,'-e',"const fs=require('node:fs');console.log(JSON.stringify("+JSON.stringify(nativeArchivePaths)+".map(p=>'/data/'+p+'/runtime/runtime-descriptor.json').filter(p=>fs.existsSync(p)).map(p=>JSON.parse(fs.readFileSync(p,'utf8')))));"]));for(const descriptor of found){assert.match(descriptor.identity,/^[a-f0-9]{24,64}$/);nativeIds.add(descriptor.identity);volumes.set('mote-hindsight-'+descriptor.identity+'-data',descriptor.identity);}});
  for(const id of nativeIds)central.add('mote-hindsight-'+id);
  for(const name of central)await attempt('register container '+name,()=>{const id=name.startsWith('mote-hindsight-')?name.slice('mote-hindsight-'.length):'';return ledger.register('container',name,id&&nativeIds.has(id)?{'mote.runtime.identity':id}:{'dev.mote.fixture':runId},id&&nativeIds.has(id)?name+'-data':undefined);});
  for(const [volume,owner] of volumes)await attempt('register volume '+volume,()=>ledger.register('volume',volume,createdVolumeLabels.get(volume)??(nativeIds.has(owner)?{'mote.runtime.identity':owner}:{'dev.mote.profile':owner})));
  for(const [volume,labels] of createdVolumeLabels)if(!volumes.has(volume))await attempt('register created volume '+volume,()=>ledger.register('volume',volume,labels));
  const receiptPath=join(evidenceRoot,'cleanup.json');await attempt('remove every registered owned resource',()=>ledger.cleanup(receiptPath));
  const receipt=existsSync(receiptPath)?JSON.parse(readFileSync(receiptPath,'utf8')):{runId,errors:[],complete:false};receipt.preCleanupErrors=errors;receipt.complete=receipt.complete&&errors.length===0;receipt.fixtureRoot=root;receipt.fixtureRootRemoved=passed&&receipt.complete;writeFileSync(receiptPath,JSON.stringify(receipt,null,2)+'\n',{mode:0o600});
  if(receipt.fixtureRootRemoved)rmSync(root,{recursive:true,force:true});progress(receipt.complete?'cleaned':'cleanup-incomplete');
  const result={...sourceProof,...completionResult,result:passed&&receipt.complete?'PASS':'FAIL',matrix:[...completedMatrix],caseAssertionsPassed:passed,cleanupComplete:receipt.complete,cleanupReceipt:receiptPath,fixtureRoot:receipt.fixtureRootRemoved?undefined:root};writeFileSync(join(evidenceRoot,'result.json'),JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(result));
  assert.equal(receipt.complete,true,'Owned cleanup incomplete; see exact receipt, fixtures preserved');
 });
 const imageId=docker(['image','inspect',image!,'--format','{{.Id}}']);assert.equal(docker(['image','inspect',image!,'--format','{{index .Config.Labels "dev.mote.runtime-source"}}']),candidate);
 assert.equal(imageId,buildProof.imageId);const imageArtifacts=JSON.parse(docker(['run','--rm','--pull','never','--network','none','--read-only','--tmpfs','/tmp:rw,nosuid,nodev,size=16m','--tmpfs','/data:rw,nosuid,nodev,size=16m','--entrypoint','node',image!,'/validation/artifact-tree.mjs','/app','/tmp/artifacts.json',...buildProof.inputPaths]));assert.equal(imageArtifacts.sha256,buildProof.artifactSha256);const imagePreflight=JSON.parse(docker(['run','--rm','--pull','never','--network','none','--read-only','--tmpfs','/tmp:rw,nosuid,nodev,size=16m','--entrypoint','node',image!,'/validation/preflight-image.mjs']));assert.equal(imagePreflight.result,'PASS');writeFileSync(join(evidenceRoot,'image-preflight.json'),JSON.stringify(imagePreflight,null,2)+'\n',{mode:0o600});
 completedMatrix.add('R0');
 docker(['image','inspect',HINDSIGHT_BACKUP_IMAGE]); // No image pull or installation.
 const release=generatedHindsightRelease();
 io=await syntheticImageIO(writeMessagesResponse,syntheticOwner('A').png);
 const generatedModels=(index:number)=>{const label=index?'B':'A';return [{id:'generated-ocr',name:'Generated OCR',settings:{...defaultModelSettings(),provider:'custom',protocol:'mote-media',baseUrl:io.baseUrl+'/ocr',apiKey:'GENERATED_RECOVERY_OCR_'+label,model:''}},{id:'generated-language',name:'Generated language',settings:{...defaultModelSettings(),provider:'custom',protocol:'anthropic-messages',model:'generated-image',baseUrl:io.baseUrl+'/v1',apiKey:'GENERATED_RECOVERY_MODEL_'+label}}];};
 app=await buildApp({dataDir:source},{pluginReleaseTransport:release.transport});
 app.processing.processors.imageRecipes.registerRecipe({id:'generated.recovery-image',version:'1',steps:[{name:'ocr',stage:{id:'mote.image-ocr',version:'1'},dependsOn:[]},{name:'understanding',stage:{id:'mote.image-understanding',version:'1'},dependsOn:['ocr'],optionalDependencies:['ocr'],when:'understanding'}]});
 progress('generated-source-ready');
 const request=async(token:string|undefined,url:string,method='GET',payload?:unknown)=>{const r=await app.app.inject({url,method,headers:{...protocol,...(token?{authorization:'Bearer '+token}:{}),...(Buffer.isBuffer(payload)?{'content-type':'application/octet-stream'}:{})},...(payload===undefined?{}:{payload})});let json;try{json=r.json();}catch{}return {status:r.statusCode,json,bytes:r.rawPayload};};
 const checked=async(...args:Parameters<typeof request>)=>{const r=await request(...args);assert.equal(r.status,200,JSON.stringify(r.json));return r.json;};
 const login=(name:string)=>checked(undefined,'/api/auth/login','POST',{username:name,password,mode:'client'});
 await app.accounts.initialize('generated-admin',password);let admin=await login('generated-admin');
 const users:any[]=[];for(const label of ['a','b']){const user=await checked(admin.token,'/api/admin/accounts','POST',{username:'generated-'+label,password});users.push({...user,...await login('generated-'+label)});}
 const change=async(token:string,domain:string,value:any)=>checked(token,'/api/configuration/'+domain,'PUT',{revision:(await checked(token,'/api/configuration')).revision,value});
 const wait=async(work:()=>Promise<boolean>|boolean,message:string)=>{const end=Date.now()+20000;while(!await work()){assert.ok(Date.now()<end,message);await delay(10);}};
 const files:any[]=[];for(const [index,user] of users.entries()){
  const view=await checked(user.token,'/api/file-processing');await checked(user.token,'/api/file-processing','PUT',{revision:view.revision,settings:{...view.settings,automatic:true,understandingEnabled:true},policy,models:{profiles:generatedModels(index),selections:{}}});
  await checked(user.token,'/api/ingress/sources','POST',{id:'same-source',name:'Generated source',kind:'local-files',deviceId:'same-device',platform:'import',retention:'archive'});
  const bytes=Buffer.from('GENERATED_COMPILED_PLAN_'+index),hash=digest(bytes.toString()),opened=await checked(user.token,'/api/ingress/sources/same-source/uploads','POST',{batchId:'same-batch',revision:{sourceId:'same-source',item:{externalId:'same-file',revision:'same-revision',observedAt:'2026-01-01T00:00:00Z',title:'Generated text',text:'',kind:'file',layer:'original',mimeType:'text/plain'},sizeBytes:bytes.length,sha256:hash,relativePath:'generated.txt'}});
  await checked(user.token,'/api/ingress/uploads/'+opened.id+'/parts/0','PUT',{bytes:bytes.toString('base64'),checksum:hash});const receipt=await checked(user.token,'/api/ingress/uploads/'+opened.id+'/commit','POST',{});files.push(receipt.captures[0]);await wait(async()=>(await checked(user.token,'/api/files/'+receipt.captures[0].id)).processing.indexed,'Generated text did not finish');
 }
 assert.equal(files[0].id,files[1].id);const deploymentId=app.deploymentId;
 const uploadGenerated=async(user:any,externalId:string,bytes:Buffer,mime:string)=>{const hash=sha256(bytes),opened=await checked(user.token,'/api/ingress/sources/same-source/uploads','POST',{batchId:randomUUID(),revision:{sourceId:'same-source',item:{externalId,revision:'same-revision',observedAt:'2026-01-01T00:00:00Z',title:'Generated recovery original',text:'',kind:'file',layer:'original',mimeType:mime},sizeBytes:bytes.length,sha256:hash,relativePath:mime==='image/png'?'generated.png':'generated.bin'}});for(const [part,body] of splitOriginal(bytes).entries())await checked(user.token,'/api/ingress/uploads/'+opened.id+'/parts/'+part,'PUT',{bytes:body.toString('base64'),checksum:sha256(body)});return (await checked(user.token,'/api/ingress/uploads/'+opened.id+'/commit','POST',{})).captures[0];};
 progress('generation-history');const generationHistory=await prepareGenerationHistory(request,users[0],users[1]);
 progress('storage-image-history');const storageHistory=await prepareStorageHistory({request,upload:uploadGenerated,directory:source,deploymentId,users,imageReady:(label,file)=>io.assign(label,file.id)});
 const imageHistory:any[]=[];
 for(const [index,history] of storageHistory.entries()){let detail:any;await wait(async()=>{detail=await checked(users[index].token,'/api/files/'+history.image.id);return detail.job?.state==='succeeded'&&detail.processing.indexed&&detail.processing.derivations.some((item:any)=>item.kind.startsWith('image:'));},'Generated built-in image did not complete');const product=detail.processing.derivations.find((item:any)=>item.kind.startsWith('image:')),typed=await checked(users[index].token,'/api/processing/artifacts/'+product.artifactId);assert.equal(typed.payload.format,'mote-image-product-v1');assert.equal(typed.payload.original.sha256,history.image.original.hash);assert.equal(typed.payload.original.width,2);assert.equal(typed.payload.original.height,2);assert.equal(typed.payload.original.mime,'image/png');assert.equal(typed.payload.interpretation.text,'HANDWRITTEN_GENERATED_'+history.label+'_INTERPRETATION');assert.equal(typed.payload.interpretation.regions[0].description,'');assert.equal((await request(users[1-index].token,'/api/processing/artifacts/'+product.artifactId)).status,404);imageHistory.push({fileId:history.image.id,product,payload:typed.payload});await wait(async()=>(await checked(users[index].token,'/api/files/'+history.plain.id)).processing.indexed,'Generated storage text did not complete');await wait(async()=>(await checked(users[index].token,generationHistory.path)).processing.indexed,'Generated current incarnation did not complete');}
 io.assertNoErrors();const imageCalls=io.snapshot();for(const label of ['A','B'])assert.deepEqual(imageCalls[label],{ocr:1,messages:2,pixelsObserved:true});
 assert.equal(storageHistory[0].image.id,storageHistory[1].image.id);assert.equal(storageHistory[0].encrypted.id,storageHistory[1].encrypted.id);await assertStorageReads(request,users,storageHistory);completedMatrix.add('R1');
 progress('attachment-history');const attachmentHistory=await prepareAttachmentHistory({app,request,directory:source,users});io.assertNoErrors();assert.deepEqual(io.snapshot(),imageCalls);
 app.execution.register({kind:'generated.policy-native-unknown',pool:'generated-policy-native',concurrency:()=>1,policy:EXECUTION_POLICIES.deterministic,parseInput:(v:any)=>v,portableInput:(v:any)=>v,execute:async(run:any)=>{run.external.begin('generated-unacknowledged-write');return null;}});
 const unknownTask=(await checked(users[0].token,'/api/tasks','POST',{kind:'generated.policy-native-unknown',operationId:'generated-unknown',input:{generated:true}})).id;
 await wait(()=>sql(source,db=>!!db.prepare("SELECT task_id FROM user_tasks WHERE task_id=? AND external_state IN ('issued','unknown')").get(unknownTask)),'Generated external issuance missing');
 await app.app.close();app=undefined;
 const initial=join(root,'initial');await backupScopedInstance({source,out:initial});
 const corruptionReceipts=await rejectCorruptSyntheticArchives({root,archive:initial,ownerRoot:storageHistory[0].ownerRoot,hash:storageHistory[0].encrypted.original.hash,restore:restoreScopedInstance});
 const makeProfile=async(name:string,archive:string)=>{const paths=profilePaths('recovery7-'+runId.slice(-12)+'-'+name,join(root,'profiles'));await initialize(paths,{runtime:'docker',image});let p=await loadProfile(paths);docker(['volume','create','--label','dev.mote.fixture='+runId,p.meta.volume]);volumes.set(p.meta.volume,p.project);const restored=await restoreProfile(p,archive,{execute});assert.ok(restored.volume);volumes.set(restored.volume,p.project);p=await loadProfile(paths);const nativePaths=JSON.parse(readFileSync(join(archive,'backup-manifest.json'),'utf8')).native;if(nativePaths.length){const descriptors=JSON.parse(docker(['run','--rm','--pull','never','--network','none','--read-only','--user',await dockerConfigurationUser(p,execute),'--mount','type=volume,source='+p.meta.volume+',target=/data,readonly','--entrypoint','node',image!,'-e',"const fs=require('node:fs');console.log(JSON.stringify("+JSON.stringify(nativePaths)+".map(p=>JSON.parse(fs.readFileSync('/data/'+p+'/runtime/runtime-descriptor.json','utf8')))));"]));for(const descriptor of descriptors){nativeIds.add(descriptor.identity);volumes.set('mote-hindsight-'+descriptor.identity+'-data',descriptor.identity);}}return p;};
 const startCentral=async(p:any,suffix:string)=>{const name=runId+'-'+suffix,user=await dockerConfigurationUser(p,execute);docker(['run','--pull','never','--detach','--name',name,'--label','dev.mote.fixture='+runId,'--network','none','--security-opt','no-new-privileges:true','--cap-drop','ALL','--user',user,'--mount','type=volume,source='+p.meta.volume+',target=/data','--mount','type=bind,source='+p.directory+',target=/config','--env','MOTE_CONFIG_FILE=/config/mote.yaml',image!]);central.add(name);docker(['exec',name,'node','-e',"(async()=>{for(let i=0;i<150;i++){try{if((await fetch('http://127.0.0.1:"+p.port+"/api/health')).ok)return;}catch{}await new Promise(r=>setTimeout(r,200));}process.exit(1);})();"]);return name;};
 const remote=(p:any,name:string,url:string,token?:string,method='GET',payload?:any)=>{const input=JSON.stringify({url:'http://127.0.0.1:'+p.port+url,method,headers:{...protocol,...(payload===undefined?{}:{'content-type':'application/json'}),...(token?{authorization:'Bearer '+token}:{})},payload}),script="(async()=>{const v=JSON.parse(require('node:fs').readFileSync(0,'utf8'));const r=await fetch(v.url,{method:v.method,headers:v.headers,body:v.payload===undefined?undefined:JSON.stringify(v.payload)});const bytes=Buffer.from(await r.arrayBuffer());let json;try{json=JSON.parse(bytes.toString())}catch{}console.log(JSON.stringify({status:r.status,json,base64:bytes.toString('base64')}));})().catch(e=>{console.error(e);process.exit(1)});";const value=JSON.parse(execFileSync('docker',['exec','-i',name,'node','-e',script],{input,encoding:'utf8',timeout:240000,maxBuffer:64*1024*1024,stdio:['pipe','pipe','pipe']}));return {...value,bytes:Buffer.from(value.base64,'base64')};};
 const ok=(p:any,name:string,url:string,token?:string,method='GET',payload?:any)=>{const r=remote(p,name,url,token,method,payload);assert.equal(r.status,200,JSON.stringify(r));return r.json;};
 const remoteLogin=(p:any,name:string,username:string)=>ok(p,name,'/api/auth/login',undefined,'POST',{username,password,mode:'client'});
 progress('compiled-personal-start');const p=await makeProfile('personal',initial),first=await startCentral(p,'personal');
 for(const user of users)assert.equal(remote(p,first,'/api/auth/self',user.token).status,401);
 const a=remoteLogin(p,first,'generated-a'),b=remoteLogin(p,first,'generated-b');
 const exportId=randomUUID();ok(p,first,'/api/portable/exports',a.token,'POST',{operationId:exportId});
 await wait(()=>ok(p,first,'/api/portable/exports/'+exportId,a.token).state==='completed','Compiled personal export did not finish');
