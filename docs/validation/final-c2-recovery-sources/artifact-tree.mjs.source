// Run on both the freshly built host tree and /app inside the new image.
// Hash files rather than relying on a source label or an old build log.
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {lstatSync, readFileSync, readdirSync, realpathSync, writeFileSync} from 'node:fs';
import {join, relative, sep} from 'node:path';
import {pathToFileURL} from 'node:url';

export function artifactTree(root, inputs) {
  root = realpathSync(root);
  const files = {};
  const visit = path => {
    const child = join(root, path);
    const rel = relative(root, child);
    assert.ok(rel && rel !== '..' && !rel.startsWith('..' + sep) && !rel.startsWith(sep));
    const resolved = relative(root, realpathSync(child));
    assert.ok(resolved && resolved !== '..' && !resolved.startsWith('..' + sep) && !resolved.startsWith(sep), 'Compiled input escaped through an ancestor symlink');
    const info = lstatSync(child);
    assert.equal(info.isSymbolicLink(), false, 'Compiled input may not resolve into another workspace');
    if (info.isDirectory()) {
      const names = readdirSync(child).sort();
      assert.ok(names.length, 'Expected emitted directory is empty: ' + path);
      for (const name of names) visit(join(path, name));
    } else {
      assert.ok(info.isFile(), 'Expected an ordinary compiled input: ' + path);
      assert.equal(info.nlink, 1, 'Compiled input is unexpectedly hard-linked');
      files[path.split(sep).join('/')] = createHash('sha256').update(readFileSync(child)).digest('hex');
    }
  };
  for (const path of inputs) visit(path);
  const sorted = Object.fromEntries(Object.entries(files).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0));
  return {files: sorted, fileCount: Object.keys(sorted).length, sha256: createHash('sha256').update(JSON.stringify(sorted)).digest('hex')};
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const [root, output, ...inputs] = process.argv.slice(2);
  assert.ok(root && output && inputs.length, 'usage: artifact-tree.mjs root output input...');
  const result = artifactTree(root, inputs);
  writeFileSync(output, JSON.stringify(result, null, 2) + '\n', {mode: 0o600});
  console.log(JSON.stringify({path: output, files: result.fileCount, sha256: result.sha256}));
}
