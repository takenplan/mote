import assert from 'node:assert/strict';
import {randomUUID, createHash} from 'node:crypto';

type Response = {status:number;json?:any;bytes?:Buffer};
type Request = (token:string,url:string,method?:string,payload?:unknown)=>Promise<Response>;
type User = {token:string;userId:string};
export type GenerationHistory={sourceId:string;externalId:string;path:string;originalPath:string;firstGeneration:number;middleGeneration:number;currentGeneration:number;oldTickets:string[];staleIntents:{operationId:string;originalGeneration:number}[];bytesHash:string;bytes:Buffer};
const sha256=(bytes:Buffer)=>createHash('sha256').update(bytes).digest('hex');
async function checked(request:Request,token:string,url:string,method='GET',payload?:unknown){const response=await request(token,url,method,payload);assert.equal(response.status,200,JSON.stringify({url,status:response.status,error:response.json}));return response.json;}

// All calls use public M03/file routes. The final driver supplies its real
// compiled Fastify/HTTP adapter; no runtime, DB or processing host is mocked.
export async function prepareGenerationHistory(request:Request,a:User,b:User):Promise<GenerationHistory>{
 const sourceId='same-lifecycle-source',externalId='same-lifecycle-file',bytes=Buffer.from('HANDWRITTEN_GENERATED_LIFECYCLE_ORIGINAL'),hash=sha256(bytes);
 const createSource=(user:User)=>checked(request,user.token,'/api/ingress/sources','POST',{id:sourceId,name:'Generated lifecycle source',kind:'local-files',deviceId:'same-device',platform:'import',retention:'archive'});
 const upload=async(user:User)=>{
  const opened=await checked(request,user.token,'/api/ingress/sources/'+sourceId+'/uploads','POST',{batchId:randomUUID(),revision:{sourceId,item:{externalId,revision:'same-revision',observedAt:'2026-01-01T00:00:00Z',title:'Generated lifecycle original',text:'',kind:'file',layer:'original',mimeType:'text/plain'},sizeBytes:bytes.length,sha256:hash,relativePath:'generated-lifecycle.txt'}});
  await checked(request,user.token,'/api/ingress/uploads/'+opened.id+'/parts/0','PUT',{bytes:bytes.toString('base64'),checksum:hash});
  const file=(await checked(request,user.token,'/api/ingress/uploads/'+opened.id+'/commit','POST',{})).captures[0];const end=Date.now()+20000;for(;;){const current=await checked(request,user.token,'/api/files/'+file.id);if(current.processing.indexed&&current.job?.state==='succeeded')break;assert.ok(Date.now()<end,'Settled source-history fixture did not reach a successful automatic processing terminal: '+JSON.stringify(current.job));await new Promise(resolve=>setTimeout(resolve,10));}return file;
 };
 await createSource(a);await createSource(b);
 const initial=await upload(a),other=await upload(b);assert.equal(initial.id,other.id);
 const path='/api/files/'+initial.id,first=await checked(request,a.token,path),originalPath='/api/ingress/originals/'+first.originalRef.slice(9);
 const oldTicket=await checked(request,a.token,originalPath+'/tickets','POST',{mode:'download'}),firstIntent={operationId:randomUUID(),originalGeneration:first.originalGeneration};
 const deleted=await checked(request,a.token,path,'DELETE',{operationId:randomUUID(),originalGeneration:first.originalGeneration});
 await checked(request,a.token,path+'/allow-again','POST',deleted.decision);assert.equal((await upload(a)).id,initial.id);
 const middle=await checked(request,a.token,path),middleIntent={operationId:randomUUID(),originalGeneration:middle.originalGeneration};assert.ok(middle.originalGeneration>first.originalGeneration);
 const middleTicket=await checked(request,a.token,originalPath+'/tickets','POST',{mode:'download'});
 await checked(request,a.token,'/api/sources/'+sourceId,'DELETE',{});await createSource(a);assert.equal((await upload(a)).id,initial.id);
 const current=await checked(request,a.token,path);assert.ok(current.originalGeneration>middle.originalGeneration);

 const history={sourceId,externalId,path,originalPath,firstGeneration:first.originalGeneration,middleGeneration:middle.originalGeneration,currentGeneration:current.originalGeneration,oldTickets:[oldTicket.ticket,middleTicket.ticket],staleIntents:[firstIntent,middleIntent],bytesHash:hash,bytes};
 await assertGenerationHistory(request,a,b,history);
 return history;
}

export async function assertGenerationHistory(request:Request,a:User,b:User,history:GenerationHistory){
 assert.equal((await checked(request,a.token,history.path)).originalGeneration,history.currentGeneration);
 assert.equal((await checked(request,b.token,history.path)).originalGeneration,0);
 for(const ticket of history.oldTickets)assert.equal((await request(a.token,history.originalPath+'/content?ticket='+encodeURIComponent(ticket))).status,404,'Old-incarnation ticket must remain retired');
 for(const intent of history.staleIntents)assert.equal((await request(a.token,history.path,'DELETE',intent)).status,409,'Old incarnation DELETE must not remove replacement');
 const ticket=await checked(request,a.token,history.originalPath+'/tickets','POST',{mode:'download'}),url=history.originalPath+'/content?ticket='+encodeURIComponent(ticket.ticket),content=await request(a.token,url);
 assert.equal(content.status,200);assert.ok(Buffer.isBuffer(content.bytes),'Read actual binary content, not a JSON/body surrogate');assert.equal(sha256(content.bytes),history.bytesHash);assert.deepEqual(content.bytes,history.bytes);
 assert.equal((await request(b.token,url)).status,404,'A current original ticket is owner-bound');
 const bDetail=await checked(request,b.token,history.path),bOriginalPath='/api/ingress/originals/'+bDetail.originalRef.slice(9);assert.notEqual(bOriginalPath,history.originalPath,'Original IDs include the owner');const ownB=await checked(request,b.token,bOriginalPath+'/tickets','POST',{mode:'download'}),contentB=await request(b.token,bOriginalPath+'/content?ticket='+encodeURIComponent(ownB.ticket));assert.equal(contentB.status,200);assert.deepEqual(contentB.bytes,history.bytes);
 return {staleDelete409:history.staleIntents.length,oldTicket404:history.oldTickets.length,currentOwnerExactBytes:true,crossOwnerDenied:true,otherOwnerPositive:true,generation:history.currentGeneration};
}
