// Compiled-C replacement for the existing generated recovery-http-host fixture.
// Only its final acceptance driver may start it; normal import is not a smoke.
import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
import {createRequire} from 'node:module';
import {readFileSync, realpathSync, existsSync} from 'node:fs';
import {join, basename, relative, sep} from 'node:path';
import {tmpdir} from 'node:os';
import {pathToFileURL} from 'node:url';
import {createHash} from 'node:crypto';

const workspace=realpathSync(process.env.MOTE_FINAL_RECOVERY_WORKSPACE || '');
const candidate=process.env.MOTE_FINAL_RECOVERY_CANDIDATE || '';
const manifestPath=process.env.MOTE_FINAL_RECOVERY_MANIFEST || '';
const manifestHash=process.env.MOTE_FINAL_RECOVERY_MANIFEST_SHA256 || '';
assert.match(candidate,/^[a-f0-9]{40}$/);assert.match(manifestHash,/^[a-f0-9]{64}$/);
const manifestBytes=readFileSync(manifestPath),manifest=JSON.parse(manifestBytes);
assert.equal(createHash('sha256').update(manifestBytes).digest('hex'),manifestHash);
assert.equal(manifest.candidate,candidate);
for(const field of ['FJ','FW','FA','Image','StatementLifecycleFix'])assert.match(manifest.sources?.[field]||'',/^[a-f0-9]{40}$/);
assert.equal(execFileSync('git',['rev-parse','HEAD'],{cwd:workspace,encoding:'utf8'}).trim(),candidate);
execFileSync('git',['diff','--exit-code',candidate,'--'],{cwd:workspace,stdio:'pipe'});
const directory=realpathSync(process.env.MOTE_GENERATED_RECOVERY_DIRECTORY || '');
const relation=relative(realpathSync(tmpdir()),directory);
assert.ok(relation&&!relation.startsWith('..'+sep)&&relation!=='..'&&!relation.startsWith(sep));
assert.match(basename(directory),/^(mote-recovery7-http-|mote-final-recovery7-)/);
const external=new URL(process.env.MOTE_GENERATED_RECOVERY_EXTERNAL || '');
assert.equal(external.protocol,'http:');assert.equal(external.hostname,'127.0.0.1');assert.ok(external.port);
if(process.env.MOTE_GENERATED_RECOVERY_INITIALIZE==='1')assert.equal(existsSync(join(directory,'mote.sqlite')),false);
// Fail closed on inherited product configuration instead of adopting a live
// config. The driver supplies a scrubbed environment and only generated data.
assert.equal(process.env.MOTE_CONFIG_FILE,undefined);
const require=createRequire(join(workspace,'apps/server/package.json'));
const {z}=require('zod');
const {buildApp}=await import(pathToFileURL(join(workspace,'apps/server/dist/app.js')));
const {EXECUTION_POLICIES}=await import(pathToFileURL(join(workspace,'apps/server/dist/execution-policy.js')));
const node=await buildApp({dataDir:directory});
if(process.env.MOTE_GENERATED_RECOVERY_INITIALIZE==='1')await node.accounts.initialize('generated-admin','Generated-recovery-seams-password');
node.execution.register({
 kind:'generated.recovery-http',pool:'generated-recovery-http',concurrency:()=>4,policy:EXECUTION_POLICIES.deterministic,
 parseInput:input=>z.object({external:z.boolean()}).strict().parse(input),portableInput:input=>input,
 execute:async run=>{
  const prior=run.checkpoint.read('completed-local-stage');
  if(!prior)run.checkpoint.write('completed-local-stage',{count:1,owner:run.context.userId});
  if(run.task.input.external){
   const issuance=run.external.begin('generated-recovery-effect');
   try{
    const reply=await fetch(external,{method:'POST',body:JSON.stringify({taskId:run.task.id,issuance,owner:run.context.userId})});
    if(!reply.ok)throw Error('Generated external transport failed');
    await reply.text();run.external.complete();process.send?.({settled:run.task.id,accepted:true});
   }catch(error){process.send?.({settled:run.task.id,accepted:false});throw error;}
  }
  return {owner:run.context.userId,checkpoint:run.checkpoint.read('completed-local-stage'),reused:Boolean(prior)};
 },
});
await node.app.listen({host:'127.0.0.1',port:0});
process.send?.({ready:node.app.server.address(),candidate,compiled:true});
process.on('message',async message=>{if(message?.close){await node.app.close();process.disconnect?.();}});
