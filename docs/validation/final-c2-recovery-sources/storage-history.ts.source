import assert from 'node:assert/strict';
import {readFileSync,existsSync} from 'node:fs';
import {join} from 'node:path';
import {createDecipheriv} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {syntheticOwner,splitOriginal,sha256,jsonHash,representation} from './final-recovery-support.ts';

type User={token:string;userId:string};
type Request=(token:string,url:string,method?:string,payload?:unknown)=>Promise<{status:number;json?:any;bytes?:Buffer}>;
type Upload=(user:User,externalId:string,bytes:Buffer,mime:string)=>Promise<any>;
type Generated=ReturnType<typeof syntheticOwner>;
export type StorageHistory={userId:string;label:'A'|'B';ownerRoot:string;fixture:Generated;plain:any;encrypted:any;image:any;pending:any;stageId:string;keyHash:string;fingerprint:string;cipherHashes:string[];pendingCipherHashes:string[];enabled:boolean;plainFormat:'plain'|'aes';multipartFormat:'plain'|'aes';imageCipherHash:string;plainCipherHash?:string;freshCommitted?:boolean;committedPendingHashes?:string[]};
async function checked(request:Request,user:User,url:string,method='GET',payload?:unknown){const response=await request(user.token,url,method,payload);assert.equal(response.status,200,JSON.stringify({url,status:response.status,error:response.json}));return response.json;}
function openSyntheticCipher(cipher:Buffer,key:Buffer){assert.ok(cipher.length>=28);const aes=createDecipheriv('aes-256-gcm',key,cipher.subarray(0,12));aes.setAuthTag(cipher.subarray(-16));return Buffer.concat([aes.update(cipher.subarray(12,-16)),aes.final()]);}

export async function prepareStorageHistory({request,upload,directory,deploymentId,users,imageReady}:{request:Request;upload:Upload;directory:string;deploymentId:string;users:User[];imageReady:(owner:'A'|'B',file:any)=>void}){
 assert.equal(users.length,2);const histories:StorageHistory[]=[];
 for(const [index,user] of users.entries()){
  const label=index===0?'A':'B',fixture=syntheticOwner(label),ownerRoot=jsonHash([deploymentId,user.userId]);
  const initial=await checked(request,user,'/api/content-storage');assert.equal(initial.enabled,false);
  const plain=await upload(user,'same-storage-plain',fixture.plain,'text/plain');
  const plainState=representation(directory,ownerRoot,plain.original.hash,0);assert.equal(plainState.plain,true);assert.equal(plainState.aes,false);assert.equal(plainState.plainHash,sha256(fixture.plain));
  const enabled=await checked(request,user,'/api/content-storage','PUT',{enabled:true,revision:initial.revision});assert.equal(enabled.enabled,true);
  const encrypted=await upload(user,'same-storage-multipart',fixture.multipart,'application/octet-stream');
  const image=await upload(user,'same-storage-image',fixture.png,'image/png');imageReady(label,image);
  const pending=await checked(request,user,'/api/import-uploads','POST',{id:'43e4b9cb-4d29-4e3a-b9fe-f25b5958d409',name:'generated-pending.bin',sizeBytes:fixture.pending.length,mimeType:'application/octet-stream'});
  for(const [part,bytes] of splitOriginal(fixture.pending).entries())await checked(request,user,'/api/import-uploads/'+pending.id+'/parts/'+part,'PUT',bytes);
  const db=new DatabaseSync(join(directory,'mote.sqlite'),{readOnly:true});let stageId:string;try{db.exec('PRAGMA busy_timeout=5000');const row=db.prepare('SELECT stage_id FROM ig_import_uploads WHERE user_id=? AND id=?').get(user.userId,pending.id);assert.ok(row);stageId=String(row.stage_id);}finally{db.close();}
  const base=join(directory,'originals',ownerRoot),keyBytes=readFileSync(join(base,'content-key')),key=Buffer.from(keyBytes.toString().trim(),'hex'),fingerprint=readFileSync(join(base,'content-key-id'),'utf8').trim();
  assert.equal(key.length,32);assert.equal(sha256(key),fingerprint);
  const cipherHashes=splitOriginal(fixture.multipart).map((bytes,part)=>{const state=representation(directory,ownerRoot,encrypted.original.hash,part);assert.equal(state.aes,true);assert.equal(state.plain,false);const cipher=readFileSync(join(base,'objects',encrypted.original.hash,part+'.aes'));assert.deepEqual(openSyntheticCipher(cipher,key),bytes);return sha256(cipher);});
  const pendingCipherHashes=splitOriginal(fixture.pending).map((bytes,part)=>{const path=join(base,'uploads',stageId,String(part));assert.equal(existsSync(path+'.plain'),false);const cipher=readFileSync(path+'.aes');assert.deepEqual(openSyntheticCipher(cipher,key),bytes);return sha256(cipher);});
  if(label==='A'){const current=await checked(request,user,'/api/content-storage');await checked(request,user,'/api/content-storage','PUT',{enabled:false,revision:current.revision});}
  const history:StorageHistory={userId:user.userId,label,ownerRoot,fixture,plain,encrypted,image,pending,stageId,keyHash:sha256(keyBytes),fingerprint,cipherHashes,pendingCipherHashes,enabled:label==='B',plainFormat:'plain',multipartFormat:'aes',imageCipherHash:sha256(readFileSync(join(base,'objects',image.original.hash,'0.aes')))};
  assertStorageFiles(directory,history);histories.push(history);
 }
 assert.notEqual(histories[0].keyHash,histories[1].keyHash,'Equal source IDs may not share an owner content key');
 assert.equal(histories[0].pending.id,histories[1].pending.id);assert.notEqual(histories[0].stageId,histories[1].stageId);
 return histories;
}

export function assertStorageFiles(directory:string,history:StorageHistory){
 const base=join(directory,'originals',history.ownerRoot),keyBytes=readFileSync(join(base,'content-key')),key=Buffer.from(keyBytes.toString().trim(),'hex');
 assert.equal(sha256(keyBytes),history.keyHash);assert.equal(readFileSync(join(base,'content-key-id'),'utf8').trim(),history.fingerprint);
 const plainPath=join(base,'objects',history.plain.original.hash,'0.'+history.plainFormat),plainBytes=readFileSync(plainPath);assert.equal(existsSync(plainPath.replace(/\.(plain|aes)$/,history.plainFormat==='aes'?'.plain':'.aes')),false);assert.deepEqual(history.plainFormat==='aes'?openSyntheticCipher(plainBytes,key):plainBytes,history.fixture.plain);if(history.plainCipherHash)assert.equal(sha256(plainBytes),history.plainCipherHash);
 for(const [part,bytes] of splitOriginal(history.fixture.multipart).entries()){const state=representation(directory,history.ownerRoot,history.encrypted.original.hash,part),path=join(base,'objects',history.encrypted.original.hash,part+'.'+history.multipartFormat),stored=readFileSync(path);assert.equal(history.multipartFormat==='aes'?state.plain:state.aes,false);if(history.multipartFormat==='aes')assert.equal(state.cipherHash,history.cipherHashes[part]);assert.deepEqual(history.multipartFormat==='aes'?openSyntheticCipher(stored,key):stored,bytes);}
 for(const [part,bytes] of splitOriginal(history.fixture.pending).entries()){const stored=readFileSync(join(base,'uploads',history.stageId,part+'.aes'));assert.equal(sha256(stored),history.pendingCipherHashes[part]);assert.deepEqual(openSyntheticCipher(stored,key),bytes);if(history.freshCommitted){const current=readFileSync(join(base,'objects',sha256(history.fixture.pending),part+'.'+(history.enabled?'aes':'plain')));assert.equal(sha256(current),history.committedPendingHashes![part]);assert.deepEqual(history.enabled?openSyntheticCipher(current,key):current,bytes);}}
 const image=readFileSync(join(base,'objects',history.image.original.hash,'0.aes'));assert.equal(sha256(image),history.imageCipherHash);assert.deepEqual(openSyntheticCipher(image,key),history.fixture.png);
 return {owner:history.label,committedMultipartParts:2,multipartFormat:history.multipartFormat,pendingEncryptedParts:2,originalHashesExact:true,contentKeyPreserved:true};
}

export function recordPersonalImportFormat(directory:string,history:StorageHistory,which:'plain'|'multipart'){
 const base=join(directory,'originals',history.ownerRoot,'objects'),file=which==='plain'?history.plain:history.encrypted,format=history.enabled?'aes':'plain';
 const states=splitOriginal(which==='plain'?history.fixture.plain:history.fixture.multipart).map((_,part)=>{const current=representation(directory,history.ownerRoot,file.original.hash,part);assert.equal(current.aes,history.enabled);assert.equal(current.plain,!history.enabled);return current;});
 if(which==='plain'){history.plainFormat=format;if(format==='aes')history.plainCipherHash=sha256(readFileSync(join(base,file.original.hash,'0.aes')));}
 else{history.multipartFormat=format;if(format==='aes')history.cipherHashes=states.map(state=>state.cipherHash!);}
 assertStorageFiles(directory,history);return {owner:history.label,object:which,format,currentOwnerPolicy:true};
}

export function recordPendingCommit(directory:string,history:StorageHistory){
 const format=history.enabled?'aes':'plain';history.committedPendingHashes=splitOriginal(history.fixture.pending).map((_,part)=>{const state=representation(directory,history.ownerRoot,sha256(history.fixture.pending),part);assert.equal(state.aes,history.enabled);assert.equal(state.plain,!history.enabled);return sha256(readFileSync(join(directory,'originals',history.ownerRoot,'objects',sha256(history.fixture.pending),part+'.'+format)));});history.freshCommitted=true;assertStorageFiles(directory,history);return {owner:history.label,parts:history.committedPendingHashes.length,format};
}

export function assertPersonalPlaintext(archive:any,history:StorageHistory,directory:string){
 const ingress=archive.domains.find((domain:any)=>domain.domain==='ingress');assert.ok(ingress);
 for(const [file,bytes] of [[history.plain,history.fixture.plain],[history.encrypted,history.fixture.multipart],[history.image,history.fixture.png]] as const){const object=ingress.payload.objects.find((row:any)=>row.hash===file.original.hash);assert.ok(object);assert.deepEqual(Buffer.from(object.bytes,'base64'),bytes);}
 const encoded=JSON.stringify(archive);assert.equal(encoded.includes(history.fingerprint),false,'Personal payload must not contain the content-key fingerprint');
 const key=readFileSync(join(directory,'originals',history.ownerRoot,'content-key'),'utf8').trim();assert.equal(encoded.includes(key),false,'Personal payload must not contain the content key');
 return {plaintextObjects:3,keyAbsent:true,keyFingerprintAbsent:true};
}

export async function commitRestoredPending(request:Request,user:User,other:User,history:StorageHistory){
 assert.equal((await request(user.token,'/api/import-uploads/'+history.pending.id+'/commit','POST',{})).status,409,'Native restore must not revive an old epoch upload admission');
 assert.equal((await request(user.token,'/api/import-uploads/'+history.pending.id+'/parts/0','PUT',splitOriginal(history.fixture.pending)[0])).status,409);
 const fresh=await checked(request,user,'/api/import-uploads','POST',{name:'generated-recovered-pending.bin',sizeBytes:history.fixture.pending.length,mimeType:'application/octet-stream'});assert.notEqual(fresh.id,history.pending.id);
 assert.equal((await request(other.token,'/api/import-uploads/'+fresh.id+'/commit','POST',{})).status,404);
 for(const [part,bytes] of splitOriginal(history.fixture.pending).entries())await checked(request,user,'/api/import-uploads/'+fresh.id+'/parts/'+part,'PUT',bytes);
 const committed=await checked(request,user,'/api/import-uploads/'+fresh.id+'/commit','POST',{}),content=await request(user.token,'/api/archived-files/'+committed.id+'/content');assert.equal(content.status,200);assert.deepEqual(content.bytes,history.fixture.pending);
 return {owner:history.label,id:committed.id,freshUploadId:fresh.id,sha256:sha256(history.fixture.pending),oldEpochCommit409:true,oldEpochPart409:true,foreignFreshAdmission404:true,newAdmission:true,exactBytes:true};
}

export async function assertStorageReads(request:Request,users:User[],histories:StorageHistory[]){
 const receipts=[];
 for(const [index,history] of histories.entries()){
  const user=users[index],other=users[1-index];assert.equal(user.userId,history.userId);
  for(const [file,bytes] of [[history.plain,history.fixture.plain],[history.encrypted,history.fixture.multipart],[history.image,history.fixture.png]] as const){const path='/api/ingress/originals/'+file.original.ref.slice(9),ticket=await checked(request,user,path+'/tickets','POST',{mode:'download'}),url=path+'/content?ticket='+encodeURIComponent(ticket.ticket),content=await request(user.token,url);assert.equal(content.status,200);assert.deepEqual(content.bytes,bytes);assert.equal((await request(other.token,url)).status,404);receipts.push({owner:history.label,hash:sha256(bytes),exactBytes:true,otherOwnerDenied:true});}
 }
 return receipts;
}
