import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {realpathSync,readFileSync} from 'node:fs';
import {join} from 'node:path';
import {pathToFileURL} from 'node:url';
import {execFileSync} from 'node:child_process';
import {createHash} from 'node:crypto';

// Run with the exact executable that will run the candidate's recovery test.
// Constructor smoke only: no app, model, Docker service or network is opened.
const workspace=realpathSync(process.argv[2]??process.cwd());
const root=createRequire(join(workspace,'package.json'));
const server=createRequire(join(workspace,'apps/server/package.json'));
const mem0Entry=server.resolve('mem0ai/oss');
const native=[];
for(const [name,load] of [['root',root],['actual-mem0',createRequire(mem0Entry)]]){
 const path=realpathSync(load.resolve('better-sqlite3'));
 assert.ok(path.startsWith(workspace+'/'),'Native dependency escaped this owned workspace');
 const Database=load('better-sqlite3'),db=new Database(':memory:');
 try{db.exec('CREATE TABLE fixture(value TEXT)');db.prepare('INSERT INTO fixture VALUES(?)').run('GENERATED_RECOVERY_ABI');assert.equal(db.prepare('SELECT value FROM fixture').get().value,'GENERATED_RECOVERY_ABI');}
 finally{db.close();}
 native.push({name,path,constructorWriteReadClose:true});
}
const modules=[];
for(const name of ['@mote/agent','@mote/shared']){
 const a=realpathSync(root.resolve(name)),b=realpathSync(server.resolve(name));
 assert.ok(a.startsWith(workspace+'/packages/'),'Workspace package escaped owned tree');assert.equal(a,b);
 assert.strictEqual(await import(pathToFileURL(a).href),await import(pathToFileURL(b).href));
 modules.push({name,root:a,server:b,sameModuleIdentity:true});
}
console.log(JSON.stringify({phase:'preflight-only',workspace,source:execFileSync('git',['rev-parse','HEAD'],{cwd:workspace,encoding:'utf8'}).trim(),executable:process.execPath,node:process.version,abi:process.versions.modules,platform:process.platform,arch:process.arch,lockSha256:createHash('sha256').update(readFileSync(join(workspace,'package-lock.json'))).digest('hex'),mem0Entry,native,modules,appStarted:false,dockerStarted:false,modelCalls:0,network:false},null,2));
