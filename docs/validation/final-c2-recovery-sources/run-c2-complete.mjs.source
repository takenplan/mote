import fs from 'node:fs';import cp from 'node:child_process';import crypto from 'node:crypto';
const a=JSON.parse(fs.readFileSync('/tmp/mote-final-recovery7-prep/active-run.json'));const b=JSON.parse(fs.readFileSync(a.root+'/build-receipt.json'));const env={...process.env,PATH:'/opt/homebrew/bin:'+process.env.PATH};for(const k of Object.keys(env))if(k.startsWith('MOTE_')||/(?:ANTHROPIC|OPENAI|GOOGLE|GEMINI|HINDSIGHT).*?(?:KEY|TOKEN|SECRET)/.test(k))delete env[k];Object.assign(env,{MOTE_FINAL_RECOVERY_WORKSPACE:a.workspace,MOTE_FINAL_RECOVERY_CANDIDATE:a.candidate,MOTE_FINAL_RECOVERY_MANIFEST:a.manifest,MOTE_FINAL_RECOVERY_MANIFEST_SHA256:a.manifestHash,MOTE_FINAL_RECOVERY_EVIDENCE_DIRECTORY:a.root,MOTE_FINAL_RECOVERY_BUILD_RECEIPT:a.root+'/build-receipt.json',MOTE_CONTAINER_VALIDATION_IMAGE:b.image});if(fs.existsSync(a.root+'/http-receipt.json'))env.MOTE_FINAL_RECOVERY_HTTP_RECEIPT=a.root+'/http-receipt.json';const log=a.root+'/native-recovery.log',out=fs.openSync(log,'w');const command=[process.execPath,'--import',a.workspace+'/node_modules/tsx/dist/loader.mjs','--test','--test-reporter=tap','/tmp/mote-final-recovery7-prep/final-c2-complete-recovery.ts'];fs.writeFileSync(a.root+'/native-command.json',JSON.stringify({command,cwd:a.workspace,candidate:a.candidate,start:new Date().toISOString(),environment:'MOTE and external credential variables scrubbed, explicit fixture values only'},null,2));const r=cp.spawnSync(command[0],command.slice(1),{cwd:a.workspace,env,stdio:['ignore',out,out]});fs.closeSync(out);const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const body=fs.readFileSync(log,'utf8'),count=name=>Number(body.match(new RegExp('^# '+name+' (\\d+)','m'))?.[1]??-1);const receipt={candidate:a.candidate,log,logSha256:hash(log),runnerSha256:hash(command.at(-1)),exit:r.status,pass:count('pass'),fail:count('fail'),skip:count('skipped'),cancelled:count('cancelled'),at:new Date().toISOString()};fs.writeFileSync(a.root+'/native-command-receipt.json',JSON.stringify(receipt,null,2));console.log(JSON.stringify(receipt));process.exitCode=r.status??1;
