// Reusable safety helper. This file never discovers resources globally.
import assert from 'node:assert/strict';
import {writeFileSync} from 'node:fs';

export class OwnedDockerResources {
  constructor(runId, execute) {
    assert.match(runId, /^mote-final-recovery7-[a-f0-9-]{36}$/);
    this.runId = runId;
    this.execute = execute;
    this.containers = new Map();
    this.volumes = new Map();
  }

  register(kind, name, labels, mountedVolume) {
    assert.ok(kind === 'container' || kind === 'volume');
    assert.match(name, /^[a-zA-Z0-9][a-zA-Z0-9_.-]+$/);
    const entries = Object.entries(labels);
    assert.ok(entries.length > 0, 'Every owned resource needs an exact provenance label');
    assert.ok(entries.every(([key, value]) => key && typeof value === 'string' && value));
    const ledger = kind === 'container' ? this.containers : this.volumes;
    const record = {name, labels, ...(mountedVolume ? {mountedVolume} : {})};
    const previous = ledger.get(name);
    if (previous) assert.deepEqual(previous, record, 'Resource provenance changed');
    ledger.set(name, record);
    return name;
  }

  async inspect(kind, name) {
    const args = kind === 'volume' ? ['volume', 'inspect', name] : ['inspect', '--type', 'container', name];
    const result = await this.execute(args);
    if (result.status === 0) {
      const value = JSON.parse(result.stdout);
      assert.equal(value.length, 1);
      if (kind === 'volume') assert.equal(value[0].Name, name);
      else assert.equal(value[0].Name, '/' + name);
      return value[0];
    }
    // Only an exact Docker not-found response counts as absence. Connection or
    // daemon errors cannot authorize a delete, and remain in the receipt.
    const diagnostic = String(result.stderr || '').trim();
    const noun = kind === 'volume' ? 'volume' : 'container';
    if (diagnostic === `Error response from daemon: get ${name}: no such volume` && kind === 'volume') return null;
    if (diagnostic === `Error response from daemon: No such ${noun}: ${name}`) return null;
    if (diagnostic === `Error: No such ${noun}: ${name}`) return null;
    if (kind === 'container' && diagnostic === `Error: No such object: ${name}`) return null;
    throw Error(`Unable to inspect owned ${kind} ${name}: status ${result.status}; ${diagnostic}`);
  }

  assertLabels(kind, state, record) {
    const actual = kind === 'volume' ? state.Labels : state.Config?.Labels;
    for (const [key, value] of Object.entries(record.labels)) {
      assert.equal(actual?.[key], value, `Refusing to touch ${kind} ${record.name}: provenance mismatch ${key}`);
    }
    if (record.mountedVolume) assert.ok(state.Mounts.some(m => m.Name === record.mountedVolume), 'Native mount provenance mismatch');
  }

  async removeOne(kind, record) {
    const state = await this.inspect(kind, record.name);
    if (!state) return {kind, name: record.name, alreadyAbsent: true};
    this.assertLabels(kind, state, record);
    if (kind === 'container' && state.State.Running) {
      const stop = await this.execute(['stop', '--time', '30', record.name]);
      assert.equal(stop.status, 0, `Owned container failed to stop: ${record.name}`);
    }
    const args = kind === 'volume' ? ['volume', 'rm', record.name] : ['rm', record.name];
    const remove = await this.execute(args);
    assert.equal(remove.status, 0, `Owned ${kind} removal failed: ${record.name}`);
    assert.equal(await this.inspect(kind, record.name), null, `Owned ${kind} remains after removal`);
    return {kind, name: record.name, absentAfterRemoval: true};
  }

  async cleanup(receiptPath) {
    const receipt = {runId: this.runId, at: new Date().toISOString(), removed: [], errors: []};
    // Each entry gets its own try/catch. A failed inspection may not abandon
    // other independently owned resources or be silently called clean.
    for (const [kind, ledger] of [['container', this.containers], ['volume', this.volumes]]) {
      for (const record of ledger.values()) {
        try { receipt.removed.push(await this.removeOne(kind, record)); }
        catch (error) { receipt.errors.push({kind, name: record.name, error: String(error)}); }
      }
    }
    receipt.complete = receipt.errors.length === 0;
    writeFileSync(receiptPath, JSON.stringify(receipt, null, 2) + '\n', {mode: 0o600});
    if (!receipt.complete) throw new AggregateError(receipt.errors.map(e => Error(e.error)), 'Owned recovery cleanup incomplete; see exact receipt');
    return receipt;
  }
}
