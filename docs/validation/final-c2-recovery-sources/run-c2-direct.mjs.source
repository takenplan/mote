import fs from 'node:fs';import cp from 'node:child_process';import assert from 'node:assert/strict';import crypto from 'node:crypto';
const a=JSON.parse(fs.readFileSync('/tmp/mote-final-recovery7-prep/active-run.json'));assert.equal(a.candidate,'8ad99089ead559d6656a269fdca7ccb884953c07');const env={...process.env,PATH:'/opt/homebrew/bin:'+process.env.PATH};for(const k of Object.keys(env))if(k.startsWith('MOTE_')||/(?:ANTHROPIC|OPENAI|GOOGLE|GEMINI|HINDSIGHT).*?(?:KEY|TOKEN|SECRET)/.test(k))delete env[k];env.MOTE_FINAL_RECOVERY_WORKSPACE=a.workspace;const results=[];const run=(name,args)=>{const log=a.root+'/'+name+'.log',fd=fs.openSync(log,'w'),r=cp.spawnSync(process.execPath,args,{cwd:a.workspace,env,stdio:['ignore',fd,fd]});fs.closeSync(fd);const body=fs.readFileSync(log,'utf8'),count=n=>Number(body.match(new RegExp('^# '+n+' (\\d+)','m'))?.[1]??-1),result={name,command:[process.execPath,...args],exit:r.status,pass:count('pass'),fail:count('fail'),skip:count('skipped'),cancelled:count('cancelled'),log,logSha256:crypto.createHash('sha256').update(fs.readFileSync(log)).digest('hex')};results.push(result);fs.writeFileSync(a.root+'/direct-checks.json',JSON.stringify({candidate:a.candidate,results},null,2));console.log(JSON.stringify(result));};const loader=['--import',a.workspace+'/node_modules/tsx/dist/loader.mjs','--test','--test-reporter=tap'];run('adjacent-60',[...loader,'--test-concurrency=4',...['private-data-lifecycle','multiuser-portable-import','multiuser-lifecycle','multiuser-lifecycle-activity','multiuser-file-attachments','multiuser-instance-backup'].map(p=>'apps/server/test/'+p+'.test.ts')]);run('original-f56-compiled',[...loader,'scripts/validation/final-e2e-attachment-personal-export.test.ts']);run('host-preflight',['/tmp/mote-final-recovery7-prep/preflight.mjs',a.workspace]);run('scope',['scripts/check-scope-contracts.mjs']);process.exitCode=results.some(r=>r.exit!==0)?1:0;
