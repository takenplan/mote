// Copied only into the validation image, outside /app's product inputs.
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {realpathSync} from 'node:fs';
import {pathToFileURL} from 'node:url';
const root=createRequire('/app/package.json'),server=createRequire('/app/apps/server/package.json');
const mem0Entry=server.resolve('mem0ai/oss'),mem0=createRequire(mem0Entry),checks=[];
for(const [name,require] of [['root',root],['actual-mem0',mem0]]){
 const path=realpathSync(require.resolve('better-sqlite3'));assert.ok(path.startsWith('/app/'));
 const Database=require('better-sqlite3'),db=new Database(':memory:');
 try{db.exec('CREATE TABLE generated_native_smoke(value TEXT)');db.prepare('INSERT INTO generated_native_smoke VALUES(?)').run('GENERATED');assert.equal(db.prepare('SELECT value FROM generated_native_smoke').get().value,'GENERATED');}finally{db.close();}
 checks.push({name,path,writeReadClose:true});
}
const identities=[];
for(const name of ['@mote/agent','@mote/shared']){
 const a=realpathSync(root.resolve(name)),b=realpathSync(server.resolve(name));
 assert.equal(a,b);assert.ok(a.startsWith('/app/packages/'));
 assert.equal(await import(pathToFileURL(a)),await import(pathToFileURL(b)));
 identities.push({name,path:a,identical:true});
}
console.log(JSON.stringify({result:'PASS',node:process.version,abi:process.versions.modules,executable:process.execPath,platform:process.platform,arch:process.arch,mem0Entry,checks,identities,appStarts:0,modelCalls:0}));
