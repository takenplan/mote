import fs from 'node:fs';import cp from 'node:child_process';import assert from 'node:assert/strict';import crypto from 'node:crypto';import {artifactTree} from './artifact-tree.mjs';
const a=JSON.parse(fs.readFileSync('/tmp/mote-final-recovery7-prep/active-run.json'));const context=a.root+'/image-context';fs.mkdirSync(context);const paths=['package.json','package-lock.json','packages/shared/package.json','packages/shared/dist','packages/shared/src/config-file.ts','packages/agent/package.json','packages/agent/dist','packages/agent/skills','packages/diagnostics/package.json','packages/diagnostics/dist','apps/server/package.json','apps/server/dist','apps/web/package.json','apps/web/dist','scripts'];for(const p of paths){fs.mkdirSync(context+'/'+p.slice(0,p.lastIndexOf('/')),{recursive:true});fs.cpSync(a.workspace+'/'+p,context+'/'+p,{recursive:true,dereference:false});}for(const p of ['artifact-tree.mjs','preflight-image.mjs'])fs.copyFileSync('/tmp/mote-final-recovery7-prep/'+p,context+'/'+p);
const base='sha256:45ba7b69cb72ae419cf5b69e6ed191767baa87ac7ac3a9d73059e9a61a8b7c38';const docker=args=>cp.execFileSync('docker',args,{encoding:'utf8',maxBuffer:4*1024*1024});const expected=crypto.createHash('sha256').update(fs.readFileSync(a.workspace+'/package-lock.json')).digest('hex');const actual=docker(['run','--rm','--pull','never','--network','none','--read-only','--tmpfs','/data:rw,size=1m','--entrypoint','node',base,'-e',"console.log(require('node:crypto').createHash('sha256').update(require('node:fs').readFileSync('/app/package-lock.json')).digest('hex'))"]).trim();assert.equal(actual,expected);const baseTag='mote-recovery7-dependency:'+a.runId.slice(-12);docker(['tag',base,baseTag]);const tag='mote-recovery7-final:'+a.candidate.slice(0,12)+'-'+a.runId.slice(-12);const remove=paths.filter(p=>p.endsWith('/dist')||p==='scripts').map(p=>'/app/'+p).join(' ');const file='FROM '+baseTag+'\nUSER root\nLABEL dev.mote.fixture="'+a.runId+'" dev.mote.runtime-source="'+a.candidate+'"\nRUN rm -rf '+remove+'\n'+paths.map(p=>'COPY '+p+' /app/'+p).join('\n')+'\nCOPY artifact-tree.mjs preflight-image.mjs /validation/\nUSER node\n';fs.writeFileSync(context+'/Dockerfile',file);const out=fs.openSync(a.root+'/image-build.log','w');const r=cp.spawnSync('docker',['build','--pull=false','--network=none','-t',tag,context],{stdio:['ignore',out,out]});fs.closeSync(out);assert.equal(r.status,0,'image build failed');const imageId=docker(['image','inspect',tag,'--format','{{.Id}}']).trim();const tree=artifactTree(a.workspace,paths);fs.writeFileSync(a.root+'/artifact-tree.json',JSON.stringify(tree,null,2));const receipt={candidate:a.candidate,manifestHash:a.manifestHash,baseImageId:base,baseTag,dependencyLockVerified:actual,lockHash:expected,inputPaths:paths,artifactSha256:tree.sha256,artifactFiles:tree.fileCount,image:tag,imageId,buildCommands:JSON.parse(fs.readFileSync(a.root+'/build-commands.json')),imageBuildExit:r.status};fs.writeFileSync(a.root+'/build-receipt.json',JSON.stringify(receipt,null,2));console.log(JSON.stringify(receipt));
